# Copia este archivo como .env.local para correr en tu compu,
# y agrega las mismas variables en Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# console.anthropic.com > API Keys (opcional: sin ella se usan las reglas básicas)
ANTHROPIC_API_KEY=

# Opcional: modelo de Claude (por defecto claude-opus-5-5; claude-haiku-5-5 es ~40x más barato)
CLAUDE_MODEL=
